<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\..\assets\brand\windows\TermLink.ico</ApplicationIcon>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>TermLink</AssemblyName>
    <RootNamespace>TermLink.Tray</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\WindowsTerminalIntegration.cs" Link="Common\WindowsTerminalIntegration.cs" />
    <ProjectReference Include="..\AgentControl\TermLink.AgentControl.csproj" />
    <ProjectReference Include="..\Agent\TermLink.Agent.csproj" />
    <ProjectReference Include="..\UpdateCore\TermLink.UpdateCore.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData"
                      Version="8.0.0"
                      GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TermLink.Tray.UpdateValidation" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\brand\windows\TermLink.ico"
                      LogicalName="TermLink.Tray.Assets.TermLink.ico" />
    <EmbeddedResource Include="..\..\..\assets\brand\windows\TermLink-preview-256.png"
                      LogicalName="TermLink.Tray.Assets.TermLink-preview-256.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgSystem_Security_Cryptography_ProtectedData)\lib\net8.0\System.Security.Cryptography.ProtectedData.dll"
             Link="System.Security.Cryptography.ProtectedData.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
</Project>
