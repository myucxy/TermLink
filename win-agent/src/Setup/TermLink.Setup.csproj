<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TermLink.Setup</AssemblyName>
    <RootNamespace>TermLink.Setup</RootNamespace>
    <ApplicationIcon>..\..\..\assets\brand\windows\TermLink.ico</ApplicationIcon>
    <PayloadPath Condition="'$(PayloadPath)' == ''">$(MSBuildProjectDirectory)\payload.zip</PayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\WindowsTerminalIntegration.cs" Link="Common\WindowsTerminalIntegration.cs" />
    <ProjectReference Include="..\AgentControl\TermLink.AgentControl.csproj" />
    <ProjectReference Include="..\UpdateCore\TermLink.UpdateCore.csproj" />
    <EmbeddedResource Include="..\..\..\assets\brand\windows\TermLink.ico"
                      LogicalName="TermLink.Setup.Assets.TermLink.ico" />
    <EmbeddedResource Include="$(PayloadPath)"
                      LogicalName="TermLink.Setup.Payload.zip"
                      Condition="Exists('$(PayloadPath)')" />
  </ItemGroup>
  <Target Name="ValidatePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PayloadPath)')"
           Text="The setup payload was not supplied. Build with -p:PayloadPath=&lt;payload.zip&gt;." />
  </Target>
</Project>
