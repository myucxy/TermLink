<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>TermLink.Agent</AssemblyName>
    <RootNamespace>TermLink.Agent</RootNamespace>
    <DefineConstants>$(DefineConstants);TERMLINK_PRODUCTION_RUNTIME</DefineConstants>
    <Configurations>Debug;Release;DirectAcceptance</Configurations>
    <TermLinkDirectDataPlaneEnabled Condition="'$(TermLinkDirectDataPlaneEnabled)' == '' And ('$(Configuration)' == 'Release' Or '$(Configuration)' == 'DirectAcceptance')">true</TermLinkDirectDataPlaneEnabled>
    <TermLinkDirectDataPlaneEnabled Condition="'$(TermLinkDirectDataPlaneEnabled)' == ''">false</TermLinkDirectDataPlaneEnabled>
    <TermLinkDirectDataPlaneAcceptance Condition="'$(TermLinkDirectDataPlaneAcceptance)' == ''">false</TermLinkDirectDataPlaneAcceptance>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TermLinkDirectDataPlaneEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);TERMLINK_DIRECT_DATA_PLANE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DirectAcceptance' And '$(TermLinkDirectDataPlaneAcceptance)' == 'true'">
    <DefineConstants>$(DefineConstants);TERMLINK_DIRECT_DATA_PLANE_ACCEPTANCE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TermLink.DirectDataPlaneEnabled"
                      Value="$(TermLinkDirectDataPlaneEnabled)" />
    <AssemblyMetadata Include="TermLink.DirectDataPlaneAcceptance"
                      Value="$(TermLinkDirectDataPlaneAcceptance)" />
  </ItemGroup>
  <Target Name="ValidateTermLinkDirectDataPlaneAcceptanceGate" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TermLinkDirectDataPlaneSymbolPresent>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])TERMLINK_DIRECT_DATA_PLANE($|[;,\s])'))</_TermLinkDirectDataPlaneSymbolPresent>
      <_TermLinkDirectDataPlaneAcceptanceSymbolPresent>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])TERMLINK_DIRECT_DATA_PLANE_ACCEPTANCE($|[;,\s])'))</_TermLinkDirectDataPlaneAcceptanceSymbolPresent>
    </PropertyGroup>
    <Error Condition="'$(TermLinkDirectDataPlaneEnabled)' != 'true' And '$(TermLinkDirectDataPlaneEnabled)' != 'false'"
           Text="TermLinkDirectDataPlaneEnabled must be exactly true or false." />
    <Error Condition="'$(TermLinkDirectDataPlaneEnabled)' == 'true' And '$(Configuration)' != 'Release' And '$(Configuration)' != 'DirectAcceptance'"
           Text="Direct data plane can only be compiled with Configuration=Release or DirectAcceptance." />
    <Error Condition="'$(_TermLinkDirectDataPlaneSymbolPresent)' == 'True' And '$(TermLinkDirectDataPlaneEnabled)' != 'true'"
           Text="TERMLINK_DIRECT_DATA_PLANE cannot be injected without the explicit build property." />
    <Error Condition="'$(TermLinkDirectDataPlaneAcceptance)' != 'true' And '$(TermLinkDirectDataPlaneAcceptance)' != 'false'"
           Text="TermLinkDirectDataPlaneAcceptance must be exactly true or false." />
    <Error Condition="'$(TermLinkDirectDataPlaneAcceptance)' == 'true' And '$(Configuration)' != 'DirectAcceptance'"
           Text="Direct data-plane acceptance can only be compiled with Configuration=DirectAcceptance." />
    <Error Condition="'$(Configuration)' == 'DirectAcceptance' And '$(TermLinkDirectDataPlaneAcceptance)' != 'true'"
           Text="Configuration=DirectAcceptance requires TermLinkDirectDataPlaneAcceptance=true." />
    <Error Condition="'$(_TermLinkDirectDataPlaneAcceptanceSymbolPresent)' == 'True' And ('$(Configuration)' != 'DirectAcceptance' Or '$(TermLinkDirectDataPlaneAcceptance)' != 'true')"
           Text="TERMLINK_DIRECT_DATA_PLANE_ACCEPTANCE cannot be injected outside the explicit DirectAcceptance build gate." />
  </Target>
  <ItemGroup>
    <Compile Include="..\Common\LocalIpc.cs" Link="Common\LocalIpc.cs" />
    <ProjectReference Include="..\AgentControl\TermLink.AgentControl.csproj" />
    <ProjectReference Include="..\Protocol\TermLink.Protocol.csproj" />
    <ProjectReference Include="..\TerminalCore\TermLink.TerminalCore.csproj" />
    <ProjectReference Include="..\UpdateCore\TermLink.UpdateCore.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <InternalsVisibleTo Include="TermLink.FileOperations.Validation" />
    <InternalsVisibleTo Include="TermLink.TerminalCore.Validation" />
    <InternalsVisibleTo Include="TermLink.AgentUpdate.Validation" />
    <InternalsVisibleTo Include="TermLink.ProductionConnectionSupervisor.Validation" />
    <InternalsVisibleTo Include="TermLink.ProductionDirectTransport.Validation" />
    <InternalsVisibleTo Include="TermLink.ProductionDirectNative.Validation" />
    <InternalsVisibleTo Include="TermLink.ProductionDirectTransportSignaling.Validation" />
    <InternalsVisibleTo Include="TermLink.ProductionSessionFaultIsolation.Validation" />
    <InternalsVisibleTo Include="TermLink" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\..\terminal-core\target\x86_64-pc-windows-msvc\release\termlink_terminal_ffi.dll')">
    <None Include="..\..\..\terminal-core\target\x86_64-pc-windows-msvc\release\termlink_terminal_ffi.dll"
          Link="termlink_terminal_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <TermLinkDirectNativeLibrary>$(MSBuildThisFileDirectory)..\..\..\network-core\target\x86_64-pc-windows-msvc\release\termlink_direct_ffi.dll</TermLinkDirectNativeLibrary>
  </PropertyGroup>
  <Target Name="ValidateTermLinkDirectNativeLibrary"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'DirectAcceptance'">
    <Error Condition="!Exists('$(TermLinkDirectNativeLibrary)')"
           Text="The pinned network-core native library is missing. Run win-agent/scripts/Build-DirectCoreNative.ps1 before building $(Configuration): $(TermLinkDirectNativeLibrary)" />
  </Target>
  <ItemGroup Condition="Exists('$(TermLinkDirectNativeLibrary)')">
    <None Include="$(TermLinkDirectNativeLibrary)"
          Link="termlink_direct_ffi.dll"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
