<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>TermLink.ProductionDirectTransport.Validation</AssemblyName>
    <RootNamespace>TermLink.ProductionDirectTransport.Validation</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DirectAcceptance' And '$(TermLinkDirectDataPlaneAcceptance)' == 'true'">
    <DefineConstants>$(DefineConstants);TERMLINK_DIRECT_DATA_PLANE_ACCEPTANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent\TermLink.Agent.csproj" />
    <ProjectReference Include="..\..\src\Protocol\TermLink.Protocol.csproj" />
    <None Include="..\..\..\protocol\test-vectors\direct-transport-crypto-v1.json"
          Link="direct-transport-crypto-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
