{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termlink.local/schemas/artifact-manifest.schema.json",
  "title": "TermLink release artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "build_number",
    "release_mode",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "release_mode": {
      "enum": [
        "production",
        "development"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "platform",
          "type",
          "version"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^artifacts/release/"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "oci-image",
              "signature",
              "setup",
              "msix",
              "apk",
              "aab"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
