<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource TermLinkBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TermLinkOutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.card.compact">
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.subtle-card">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource TermLinkPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkOnSurfaceBrush}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkMutedBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource TermLinkDangerContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkDangerBrush}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
  </Style>

  <Style Selector="Button.sidebar-card">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkOnSurfaceBrush}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="Button.sidebar-card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceElevatedBrush}" />
  </Style>
  <Style Selector="Button.sidebar-card.update">
    <Setter Property="Background" Value="{DynamicResource TermLinkPositiveContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkPositiveBrush}" />
  </Style>

  <Style Selector="Border.account-avatar">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource TermLinkPrimaryBrush}" />
  </Style>
  <Style Selector="Border.account-avatar.muted">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceElevatedBrush}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkMutedBrush}" />
    <Setter Property="Padding" Value="13,11" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkPrimaryBrush}" />
  </Style>

  <Style Selector="Button.section-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="Button.section-nav.selected">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TermLinkPositiveBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TermLinkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
  </Style>

  <Style Selector="ListBox.clean">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.status-dot">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource TermLinkMutedBrush}" />
  </Style>
  <Style Selector="Border.status-dot.online">
    <Setter Property="Background" Value="{DynamicResource TermLinkPositiveBrush}" />
  </Style>
  <Style Selector="Border.status-dot.warning">
    <Setter Property="Background" Value="{DynamicResource TermLinkWarningBrush}" />
  </Style>
  <Style Selector="Border.status-dot.error">
    <Setter Property="Background" Value="{DynamicResource TermLinkDangerBrush}" />
  </Style>
  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.status-pill.positive">
    <Setter Property="Background" Value="{DynamicResource TermLinkPositiveContainerBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource TermLinkSurfaceVariantBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TermLinkOutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.notice.success">
    <Setter Property="Background" Value="{DynamicResource TermLinkPositiveContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TermLinkPositiveBrush}" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource TermLinkWarningContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TermLinkWarningBrush}" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource TermLinkDangerContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TermLinkDangerBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
</Styles>
