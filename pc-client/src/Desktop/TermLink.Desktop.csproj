<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <AssemblyName>TermLink</AssemblyName>
    <RootNamespace>TermLink.Desktop</RootNamespace>
    <Authors>清风惹尘丶</Authors>
    <Company>清风惹尘丶</Company>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net8.0-windows'">..\..\..\assets\brand\windows\TermLink.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TermLink.TerminalSurface.Validation" />
    <Compile Include="..\..\..\win-agent\src\Common\NativeDisplayProtocol.cs" Link="NativeDisplayProtocol.cs" />
    <Compile Include="..\..\..\win-agent\src\Common\NativeDisplaySignals.cs" Link="NativeDisplaySignals.cs" />
    <PackageReference Include="Avalonia" ExcludeAssets="analyzers" GeneratePathProperty="true" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\Windows\TermLink.Platform.Windows.csproj" />
    <None Include="..\..\..\native\terminal-core\windows-x64\termlink_terminal_ffi.dll"
          Link="termlink_terminal_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Agent.Local\TermLink.Agent.Local.csproj" />
    <ProjectReference Include="..\Linux\TermLink.Platform.Linux.csproj" />
    <ProjectReference Include="..\MacOS\TermLink.Platform.MacOS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\..\assets\brand\windows\TermLink.ico"
                      Link="Assets\TermLink.ico" />
    <AvaloniaResource Include="..\..\..\android\terminal-engine-api\src\main\assets\termlink-fonts\CaskaydiaCoveNerdFontMono-Regular.ttf"
                      Link="Assets\Fonts\CaskaydiaCoveNerdFontMono-Regular.ttf" />
    <None Include="..\..\..\android\terminal-engine-api\src\main\assets\termlink-fonts\LICENSE.txt"
          Link="licenses\terminal-font\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\android\terminal-engine-api\src\main\assets\termlink-fonts\NOTICE.txt"
          Link="licenses\terminal-font\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Contracts\TermLink.Pc.Contracts.csproj" />
    <ProjectReference Include="..\Platform.Abstractions\TermLink.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\Presentation\TermLink.Presentation.csproj" />
    <ProjectReference Include="..\..\..\win-agent\src\TerminalCore\TermLink.TerminalCore.csproj" />
    <None Include="..\..\..\LICENSE;..\..\..\NOTICE" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\licenses\Legacy-Charsets-MIT-LICENSE.txt" Link="Legacy-Charsets-MIT-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\licenses\Unicode-16-LICENSE.txt" Link="Unicode-16-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveIncompatibleAvaloniaAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="$(PkgAvalonia)\analyzers\dotnet\cs\*.dll" />
    </ItemGroup>
  </Target>
</Project>
