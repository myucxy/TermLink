<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TermLink.Presentation"
        xmlns:text="using:TermLink.Presentation"
        xmlns:contracts="using:TermLink.Pc.Contracts"
        x:Class="TermLink.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TermLink PC"
        Icon="avares://TermLink/Assets/TermLink.ico"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="600">
  <Grid ColumnDefinitions="204,*">
    <Border Grid.Column="0"
            Background="{DynamicResource TermLinkSurfaceBrush}"
            BorderBrush="{DynamicResource TermLinkOutlineBrush}"
            BorderThickness="0,0,1,0"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="4,4,4,0">
          <Grid ColumnDefinitions="32,*" ColumnSpacing="9">
            <Image Source="avares://TermLink/Assets/TermLink.ico" Width="28" Height="28" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="TermLink" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{x:Static text:PresentationText.ControlCenter}" Classes="muted" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
          <Button Classes="nav"
                  Classes.selected="{Binding IsDevicesPageSelected}"
                  AutomationProperties.Name="设备"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="devices">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <PathIcon Data="{DynamicResource TermLinkDevicesIcon}" Width="21" Height="21" />
              <TextBlock Grid.Column="1" Text="{x:Static text:PresentationText.Devices}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
          </Button>
          <Button Classes="nav"
                  Classes.selected="{Binding IsSessionsPageSelected}"
                  AutomationProperties.Name="会话"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="sessions">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <PathIcon Data="{DynamicResource TermLinkTerminalIcon}" Width="21" Height="21" />
              <TextBlock Grid.Column="1" Text="{x:Static text:PresentationText.Sessions}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
          </Button>
          <Button Classes="nav"
                  Classes.selected="{Binding IsSettingsPageSelected}"
                  AutomationProperties.Name="设置"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="settings">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <PathIcon Data="{DynamicResource TermLinkSettingsIcon}" Width="21" Height="21" />
              <TextBlock Grid.Column="1" Text="{x:Static text:PresentationText.Settings}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel x:Name="SidebarIdentityPanel" Grid.Row="3" Spacing="8">
          <Border x:Name="SidebarComputerCard" Classes="subtle-card" Padding="10">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Grid Width="36" Height="36">
                <PathIcon Data="{DynamicResource TermLinkDevicesIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="SidebarComputerNameText" Grid.Column="1"
                         Text="{Binding AgentName}"
                         ToolTip.Tip="{Binding AgentName}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Border x:Name="SidebarAccountLoading" Classes="subtle-card" Padding="10" MinHeight="52" IsVisible="{Binding IsAccountStateLoading}">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Grid Width="36" Height="36">
                <PathIcon Data="{DynamicResource TermLinkAccountIcon}" Foreground="{DynamicResource TermLinkMutedBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1" Text="{x:Static text:PresentationText.AccountLoading}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Button x:Name="SidebarAccountButton"
                  Classes="sidebar-card"
                  IsVisible="{Binding IsAccountLinked}"
                  Command="{Binding OpenAccountSettingsCommand}"
                  AutomationProperties.Name="当前账户">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Border Classes="account-avatar">
                <TextBlock x:Name="SidebarAvatarInitialText" Text="{Binding Account.AccountAvatarInitial}" Foreground="{DynamicResource TermLinkOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SidebarNicknameText" Text="{Binding Account.AccountDisplayName}"
                           ToolTip.Tip="{Binding Account.AccountDisplayName}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SidebarUsernameText" Text="{Binding Account.AccountUsernameDisplay}"
                           ToolTip.Tip="{Binding Account.AccountUsernameDisplay}"
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Button>

          <Button x:Name="SidebarLoginButton"
                  Classes="sidebar-card"
                  IsVisible="{Binding IsAccountSignedOut}"
                  Command="{Binding OpenAccountSettingsCommand}"
                  AutomationProperties.Name="登录 TermLink 账户">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Border Classes="account-avatar muted">
                <PathIcon Data="{DynamicResource TermLinkAccountIcon}" Foreground="{DynamicResource TermLinkMutedBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding AccountActionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="SidebarUpdateButton"
                  Classes="sidebar-card update"
                  IsVisible="{Binding HasAvailableUpdate}"
                  Command="{Binding OpenAboutUpdatesCommand}"
                  AutomationProperties.Name="打开 TermLink 更新">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Grid Width="36" Height="36">
                <PathIcon Data="{DynamicResource TermLinkRefreshIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1"
                         Text="{Binding AvailableUpdateText}"
                         ToolTip.Tip="{Binding AvailableUpdateText}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="72,*">
      <Border Grid.Row="0" BorderBrush="{DynamicResource TermLinkOutlineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CurrentPageTitleText" Text="{Binding CurrentPage.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentPageSubtitleText" Text="{Binding CurrentPageSubtitle}" Classes="muted" FontSize="12" />
          </StackPanel>
          <Border x:Name="ServerStatusPill"
                  Grid.Column="1"
                  Classes="status-pill"
                  Classes.positive="{Binding IsConnected}"
                  Classes.warning="{Binding IsConnectionBusy}"
                  Classes.error="{Binding IsServerDisconnected}"
                  ToolTip.Tip="{Binding ServerConnectionToolTip}"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
              <Border x:Name="ServerStatusDot"
                      Classes="status-dot"
                      Classes.online="{Binding IsConnected}"
                      Classes.warning="{Binding IsConnectionBusy}"
                      Classes.error="{Binding IsServerDisconnected}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
            </Grid>
          </Border>
          <Button Grid.Column="2" Classes="icon" AutomationProperties.Name="刷新 Agent 状态" Command="{Binding RefreshCommand}">
            <PathIcon Data="{DynamicResource TermLinkRefreshIcon}" Width="20" Height="20" />
          </Button>
        </Grid>
      </Border>

      <Grid x:Name="NoticeOverlay"
            Grid.Row="1"
            Panel.ZIndex="10"
            Width="520"
            Margin="28,0,28,26"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsVisible="{Binding HasNotice}">
        <Border Classes="notice" IsVisible="{Binding IsInfoNotice}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding NoticeDetail}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !!NoticeDetail}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="关闭通知" />
          </Grid>
        </Border>
        <Border Classes="notice success" IsVisible="{Binding IsSuccessNotice}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel><TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding NoticeDetail}" TextWrapping="Wrap" /></StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="关闭通知" />
          </Grid>
        </Border>
        <Border Classes="notice warning" IsVisible="{Binding IsWarningNotice}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel><TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding NoticeDetail}" TextWrapping="Wrap" /></StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="关闭通知" />
          </Grid>
        </Border>
        <Border Classes="notice error" IsVisible="{Binding IsErrorNotice}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding NoticeDetail}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NoticeCode}" Classes="mono" FontSize="11" Margin="0,5,0,0" Opacity="0.75" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="关闭通知" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="28,20,28,26">
        <ScrollViewer x:Name="DevicesPageRoot" IsVisible="{Binding IsDevicesPageSelected}" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <StackPanel x:Name="DevicesContentRoot" MaxWidth="{DynamicResource TermLinkContentMaxWidth}" HorizontalAlignment="Stretch" Spacing="18" Margin="0,0,16,0">
            <Border x:Name="ConnectionPageRoot" Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="status-dot" Classes.online="{Binding IsConnected}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{x:Static text:PresentationText.RemoteAccess}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Static text:PresentationText.RemoteAccessDetail}" Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Content="{x:Static text:PresentationText.Enable}"
                            IsVisible="{Binding CanEnableRemoteAccess}"
                            Command="{Binding SetRemoteAccessCommand}" CommandParameter="true" />
                    <Button Classes="danger" Content="{x:Static text:PresentationText.Stop}"
                            IsVisible="{Binding CanDisableRemoteAccess}"
                            Command="{Binding SetRemoteAccessCommand}" CommandParameter="false" />
                    <Button Classes="primary" Content="{x:Static text:PresentationText.SignInAgain}"
                            IsVisible="{Binding RequiresReauthentication}"
                            Command="{Binding OpenAccountSettingsCommand}" />
                    <Button Classes="subtle" Content="{x:Static text:PresentationText.RetryNow}"
                            IsVisible="{Binding CanRetryConnection}"
                            Command="{Binding RetryConnectionCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="SessionsPageRoot" IsVisible="{Binding IsSessionsPageSelected}" MaxWidth="{DynamicResource TermLinkContentMaxWidth}" HorizontalAlignment="Stretch">
          <Grid>
            <Border Classes="card" IsVisible="{Binding HasNoSessions}" VerticalAlignment="Top">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4">
                <PathIcon Data="{DynamicResource TermLinkTerminalIcon}" Width="32" Height="32" Foreground="{DynamicResource TermLinkMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static text:PresentationText.NoSessions}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static text:PresentationText.NoSessionsDetail}" Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <ListBox x:Name="SessionList" Classes="clean" ItemsSource="{Binding Sessions.Items}" IsVisible="{Binding HasSessions}" ScrollViewer.AllowAutoHide="False">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionListItemViewModel">
                  <Border Classes="card compact" Margin="0,0,16,8">
                    <Grid ColumnDefinitions="Auto,*,170,Auto" ColumnSpacing="12">
                      <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <Border Classes="status-dot" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Classes="status-dot online" IsVisible="{Binding IsHealthy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Classes="status-dot warning" IsVisible="{Binding IsWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Classes="status-dot error" IsVisible="{Binding IsError}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetailText}"
                                    ToolTip.Tip="{Binding DetailText}"
                                    Classes="muted"
                                    FontSize="12"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ViewerText}" Classes="muted" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="3" Classes="danger" Content="{x:Static text:PresentationText.StopSession}"
                              IsVisible="{Binding CanStop}"
                              Command="{Binding $parent[Window].DataContext.StopSessionCommand}"
                              CommandParameter="{Binding SessionId}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsPageRoot" IsVisible="{Binding IsSettingsPageSelected}" RowDefinitions="Auto,*" MaxWidth="{DynamicResource TermLinkContentMaxWidth}" HorizontalAlignment="Stretch">
          <StackPanel Margin="0,0,0,14">
            <WrapPanel>
              <Button Classes="section-nav" Classes.selected="{Binding IsGeneralSettingsSelected}" Content="{x:Static text:PresentationText.General}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="general" />
              <Button Classes="section-nav" Classes.selected="{Binding IsAccountSettingsSelected}" Content="{x:Static text:PresentationText.Account}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="account" />
              <Button Classes="section-nav" Classes.selected="{Binding IsAgentsSettingsSelected}" Content="AI Agent" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="agents" />
              <Button Classes="section-nav" Classes.selected="{Binding IsCommandsSettingsSelected}" Content="{x:Static text:PresentationText.Commands}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="commands" />
              <Button Classes="section-nav" Classes.selected="{Binding IsIntegrationSettingsSelected}" Content="{x:Static text:PresentationText.Integration}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="integration" />
              <Button Classes="section-nav" Classes.selected="{Binding IsDiagnosticsSettingsSelected}" Content="{x:Static text:PresentationText.Diagnostics}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="diagnostics" />
              <Button Classes="section-nav" Classes.selected="{Binding IsAboutSettingsSelected}" Content="{x:Static text:PresentationText.About}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="about" />
            </WrapPanel>
          </StackPanel>

          <ScrollViewer x:Name="SettingsContentScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <Grid x:Name="SettingsContentRoot" Margin="0,0,16,0">
              <StackPanel x:Name="GeneralSettingsRoot" IsVisible="{Binding IsGeneralSettingsSelected}" Spacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <StackPanel><TextBlock Classes="section-title" Text="{x:Static text:PresentationText.ThisDevice}" /><TextBlock Classes="muted" Text="{x:Static text:PresentationText.ThisDeviceDetail}" /></StackPanel>
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                      <TextBlock Text="{x:Static text:PresentationText.PcName}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding Account.PcName}" AutomationProperties.Name="PC 名称" />
                      <TextBlock Grid.Row="1" Text="{x:Static text:PresentationText.Platform}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Platform}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Text="{x:Static text:PresentationText.AgentVersion}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Version}" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <StackPanel><TextBlock Classes="section-title" Text="{x:Static text:PresentationText.Appearance}" /><TextBlock Classes="muted" Text="{x:Static text:PresentationText.AppearanceDetail}" /></StackPanel>
                    <WrapPanel>
                      <Button Classes="section-nav" Classes.selected="{Binding IsSystemAppearance}" Content="{x:Static text:PresentationText.FollowSystem}" Command="{Binding SetAppearanceCommand}" CommandParameter="System" />
                      <Button Classes="section-nav" Classes.selected="{Binding IsLightAppearance}" Content="{x:Static text:PresentationText.LightTheme}" Command="{Binding SetAppearanceCommand}" CommandParameter="Light" />
                      <Button Classes="section-nav" Classes.selected="{Binding IsDarkAppearance}" Content="{x:Static text:PresentationText.DarkTheme}" Command="{Binding SetAppearanceCommand}" CommandParameter="Dark" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="AccountPageRoot" IsVisible="{Binding IsAccountSettingsSelected}" Spacing="14">
                <Border x:Name="ServerConfigurationCard" Classes="card">
                  <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel>
                      <TextBlock Classes="section-title" Text="{x:Static text:PresentationText.ServerUrl}" />
                      <TextBlock Classes="muted" Text="{x:Static text:PresentationText.ServerUrlDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Text="{Binding Account.ServerUrl}" PlaceholderText="{x:Static text:PresentationText.ServerUrlHint}" />
                    <Button Classes="primary" Content="{x:Static text:PresentationText.Configure}" Command="{Binding ConfigureServerCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border x:Name="LinkedAccountCard" Classes="card" IsVisible="{Binding IsAccountLinked}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="eyebrow" Text="{x:Static text:PresentationText.SignedIn}" />
                      <TextBlock Text="{Binding Account.AccountDisplayName}" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Account.AccountUsernameDisplay}" Classes="muted" />
                      <TextBlock Text="{x:Static text:PresentationText.AccountPrivacy}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="danger" Content="{x:Static text:PresentationText.SignOut}" Command="{Binding SignOutCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border x:Name="AccountSignInCard" Classes="card" IsVisible="{Binding IsAccountSignedOut}">
                  <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel><TextBlock Classes="section-title" Text="{Binding AccountStateTitle}" /><TextBlock Classes="muted" Text="{Binding AccountStateDetail}" TextWrapping="Wrap" /></StackPanel>
                    <Border Classes="subtle-card">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="account-avatar muted" Width="36" Height="36" VerticalAlignment="Top">
                          <PathIcon Data="{DynamicResource TermLinkAccountIcon}" Foreground="{DynamicResource TermLinkMutedBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Static text:PresentationText.BrowserAccountAuthorizationDetail}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <Border x:Name="BrowserAuthorizationProgress" Classes="notice" IsVisible="{Binding BeginAccountAuthorizationCommand.IsRunning}">
                      <TextBlock Text="{x:Static text:PresentationText.BrowserAuthorizationStartedDetail}" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="BrowserAccountAuthorizationButton"
                            Classes="primary"
                            Content="{x:Static text:PresentationText.BrowserAccountAuthorization}"
                            Command="{Binding BeginAccountAuthorizationCommand}"
                            IsEnabled="{Binding !BeginAccountAuthorizationCommand.IsRunning}"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <Grid IsVisible="{Binding IsAgentsSettingsSelected}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="AI Agent" FontWeight="SemiBold" />
                    <TextBlock Text="检测中…" IsVisible="{Binding DetectAiAgentsCommand.IsRunning}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="重新检测" Command="{Binding DetectAiAgentsCommand}" />
                </Grid>
                <TextBlock Grid.Row="1" Text="自动识别本机安装与协议。认证由 Agent 本身处理，首次对话后确认。" TextWrapping="Wrap" />
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Settings.AiAgents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:AiAgentCapability">
                      <StackPanel Margin="0,4" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" />
                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="3" Spacing="6" IsVisible="{Binding SupportsZcodeRemoteConfiguration}">
                  <TextBlock Text="ZCode 桌面远控" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Settings.ZcodeRemoteStatus}" FontSize="12" />
                  <TextBox Text="{Binding Settings.ZcodeRemoteUrl, Mode=TwoWay}" PasswordChar="●" MaxLength="8192"
                           PlaceholderText="粘贴 https://zcode.z.ai/remote/ 远控地址" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保存地址" Command="{Binding SaveZcodeRemoteCommand}" />
                    <Button Content="清除" Command="{Binding ClearZcodeRemoteCommand}" />
                  </StackPanel>
                  <TextBlock Text="配置后，安卓在 AI 中打开桌面远控网页。ZCode 桌面需开启远控；地址失效时重新粘贴保存。" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Grid>
              <Grid x:Name="CommandsSettingsRoot" IsVisible="{Binding IsCommandsSettingsSelected}" RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                  <StackPanel><TextBlock Classes="section-title" Text="{x:Static text:PresentationText.AvailableCommands}" /><TextBlock Classes="muted" Text="{x:Static text:PresentationText.CommandsDetail}" TextWrapping="Wrap" /></StackPanel>
                  <Button Grid.Column="1" Classes="primary" Content="{x:Static text:PresentationText.AddCustomCommand}" Command="{Binding OpenTerminalCommandEditorCommand}" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Classes="notice warning" IsVisible="{Binding Settings.HasUnsavedCommands}" Margin="0,0,0,12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{x:Static text:PresentationText.UnsavedChanges}" VerticalAlignment="Center" FontWeight="SemiBold" /><Button Grid.Column="1" Classes="primary" Content="{x:Static text:PresentationText.Save}" Command="{Binding SaveTerminalCommandsCommand}" /></Grid>
                </Border>
                <ListBox x:Name="CommandList" Grid.Row="2" Classes="clean" ItemsSource="{Binding Settings.TerminalCommands}">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="contracts:TerminalCommandCapability">
                      <Border Classes="card compact" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Executable}" Classes="muted mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Center">
                            <Grid>
                              <TextBlock Text="{x:Static text:PresentationText.AutomaticCommand}" IsVisible="{Binding Detected}" FontSize="12" />
                              <TextBlock Text="{x:Static text:PresentationText.CustomCommand}" IsVisible="{Binding !Detected}" FontSize="12" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="subtle" Content="{x:Static text:PresentationText.Edit}" Command="{Binding $parent[Window].DataContext.OpenTerminalCommandEditorCommand}" CommandParameter="{Binding}" />
                            <Button Classes="danger" Content="{x:Static text:PresentationText.Delete}" Command="{Binding $parent[Window].DataContext.RemoveTerminalCommandCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <StackPanel x:Name="IntegrationSettingsRoot" IsVisible="{Binding IsIntegrationSettingsSelected}" Spacing="14">
                <Border Classes="card">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel><TextBlock Classes="section-title" Text="Windows Terminal" /><TextBlock Text="{x:Static text:PresentationText.TerminalIntegrationDetail}" Classes="muted" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button x:Name="ConfigureTerminalIntegrationButton" Classes="subtle" Content="{x:Static text:PresentationText.Configure}" AutomationProperties.Name="配置 Windows Terminal 集成" Command="{Binding OpenTerminalIntegrationSettingsCommand}" />
                      <Button Classes="subtle" Content="{x:Static text:PresentationText.RepairTerminal}" AutomationProperties.Name="修复 Windows Terminal 集成" Command="{Binding RepairTerminalIntegrationCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel x:Name="DiagnosticsPageRoot" IsVisible="{Binding IsDiagnosticsSettingsSelected}" Spacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <StackPanel><TextBlock Classes="section-title" Text="{x:Static text:PresentationText.AdvancedDiagnostics}" /><TextBlock Classes="muted" Text="{x:Static text:PresentationText.DiagnosticsDetail}" /></StackPanel>
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                      <TextBlock Text="PC ID" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Diagnostics.PcId}" Classes="mono" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Text="{x:Static text:PresentationText.Revision}" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Diagnostics.Revision}" />
                      <TextBlock Grid.Row="2" Text="{x:Static text:PresentationText.ObservedAt}" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Diagnostics.ObservedAt}" />
                      <TextBlock Grid.Row="3" Text="Relay" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Diagnostics.ServerOrigin}" Classes="mono" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="4" Text="{x:Static text:PresentationText.Capabilities}" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Diagnostics.Capabilities}" Classes="mono" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="5" Text="{x:Static text:PresentationText.LastError}" FontWeight="SemiBold" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Diagnostics.LastError}" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Button Classes="subtle" Content="{x:Static text:PresentationText.OpenLogs}" AutomationProperties.Name="打开 TermLink 诊断日志目录" Command="{Binding OpenDiagnosticsDirectoryCommand}" HorizontalAlignment="Left" />
              </StackPanel>

              <StackPanel x:Name="AboutSettingsRoot" IsVisible="{Binding IsAboutSettingsSelected}" Spacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                      <Image Source="avares://TermLink/Assets/TermLink.ico" Width="56" Height="56" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TermLink PC" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static text:PresentationText.AboutDetail}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                      <TextBlock Text="{x:Static text:PresentationText.ApplicationVersion}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Settings.ApplicationVersion}" Classes="mono" />
                      <TextBlock Grid.Row="1" Text="{x:Static text:PresentationText.Author}" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Author}" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Classes="card" IsVisible="{Binding Settings.HasReleaseNotes}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="{Binding Settings.ReleaseNotesTitle}" />
                    <TextBlock Text="{Binding Settings.ReleaseNotes}" Classes="muted" TextWrapping="Wrap" LineHeight="24" />
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="5"><TextBlock Classes="section-title" Text="{x:Static text:PresentationText.DesktopAndUpdates}" /><TextBlock Text="{x:Static text:PresentationText.UpdateSafetyDetail}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Settings.UpdateStatusText}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
                    <Button x:Name="AboutUpdateActionButton" Grid.Column="1" Classes="primary" Content="{Binding UpdateActionText}" AutomationProperties.Name="执行 TermLink 更新操作" Command="{Binding UpdateActionCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="ConfirmationOverlay" Grid.ColumnSpan="2" Background="{DynamicResource TermLinkScrimBrush}" IsVisible="{Binding ConfirmationVisible}" ZIndex="100">
      <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ConfirmationTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConfirmationDetail}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="subtle" Content="{x:Static text:PresentationText.Cancel}" Command="{Binding CancelPendingActionCommand}" />
            <Button Classes="danger" Content="{x:Static text:PresentationText.ConfirmAction}" Command="{Binding ConfirmPendingActionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="UpdateProgressOverlay" Grid.ColumnSpan="2" Background="{DynamicResource TermLinkScrimBrush}" IsVisible="{Binding UpdateProgressVisible}" ZIndex="105">
      <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static text:PresentationText.DownloadingUpdate}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UpdateProgressText}" Classes="muted" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent}" Height="8" AutomationProperties.Name="更新下载进度" />
          <Button x:Name="CancelUpdateDownloadButton" Classes="subtle" Content="{x:Static text:PresentationText.Cancel}" Command="{Binding CancelUpdateDownloadCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="TerminalIntegrationEditor" Grid.ColumnSpan="2" Background="{DynamicResource TermLinkScrimBrush}" IsVisible="{Binding Settings.TerminalIntegrationEditorOpen}" ZIndex="95">
      <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static text:PresentationText.TerminalIntegrationOptions}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static text:PresentationText.TerminalIntegrationOptionsDetail}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static text:PresentationText.PackageManagedTerminalIntegration}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Settings.CanConfigureTerminalIntegration}" />
          </StackPanel>
          <CheckBox x:Name="TerminalAddNoLogoCheckBox" IsChecked="{Binding Settings.TerminalAddNoLogo}" IsEnabled="{Binding Settings.CanConfigureTerminalIntegration}" AutomationProperties.Name="添加 -NoLogo">
            <StackPanel>
              <TextBlock Text="{x:Static text:PresentationText.AddNoLogo}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static text:PresentationText.AddNoLogoDetail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="TerminalAddNoProfileCheckBox" IsChecked="{Binding Settings.TerminalAddNoProfile}" IsEnabled="{Binding Settings.CanConfigureTerminalIntegration}" AutomationProperties.Name="添加 -NoProfile">
            <StackPanel>
              <TextBlock Text="{x:Static text:PresentationText.AddNoProfile}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static text:PresentationText.AddNoProfileDetail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="subtle" Content="{x:Static text:PresentationText.Cancel}" Command="{Binding CancelTerminalIntegrationSettingsCommand}" />
            <Button x:Name="SaveTerminalIntegrationButton" Classes="primary" Content="{x:Static text:PresentationText.Save}" Command="{Binding SaveTerminalIntegrationSettingsCommand}" IsEnabled="{Binding Settings.CanConfigureTerminalIntegration}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.ColumnSpan="2" Background="{DynamicResource TermLinkScrimBrush}" IsVisible="{Binding Settings.CommandEditorOpen}" ZIndex="90">
      <Border Classes="card" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="14">
          <TextBlock Text="{x:Static text:PresentationText.AddCustomCommand}" FontSize="20" FontWeight="SemiBold" />
          <StackPanel Spacing="5"><TextBlock Text="{x:Static text:PresentationText.CommandDisplayName}" /><TextBox x:Name="NewCommandName" Text="{Binding Settings.NewCommandName}" AutomationProperties.Name="命令显示名称" /></StackPanel>
          <StackPanel Spacing="5"><TextBlock Text="{x:Static text:PresentationText.CommandExecutable}" /><TextBox Text="{Binding Settings.NewExecutable}" AutomationProperties.Name="命令可执行文件" /></StackPanel>
          <StackPanel Spacing="5"><TextBlock Text="{x:Static text:PresentationText.CommandArguments}" /><TextBox Text="{Binding Settings.NewArguments}" AutomationProperties.Name="命令参数" /></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="subtle" Content="{x:Static text:PresentationText.Cancel}" Command="{Binding CancelTerminalCommandEditorCommand}" />
            <Button Classes="primary" Content="{x:Static text:PresentationText.Add}" Command="{Binding AddTerminalCommandCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
