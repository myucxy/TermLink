      <SolidColorBrush x:Key="TermLinkPositiveBrush" Color="#65D6A1" />
      <SolidColorBrush x:Key="TermLinkOnPositiveBrush" Color="#062A1A" />
      <SolidColorBrush x:Key="TermLinkWarningBrush" Color="#F1C96B" />
      <SolidColorBrush x:Key="TermLinkDangerBrush" Color="#FF8C91" />
      <SolidColorBrush x:Key="TermLinkOnSurfaceBrush" Color="#E9EEF5" />
      <SolidColorBrush x:Key="TermLinkMutedBrush" Color="#AAB5C5" />
      <SolidColorBrush x:Key="TermLinkOutlineBrush" Color="#465363" />
      <SolidColorBrush x:Key="TermLinkScrimBrush" Color="#B3000000" />
      <SolidColorBrush x:Key="TermLinkDangerContainerBrush" Color="#4A2026" />
