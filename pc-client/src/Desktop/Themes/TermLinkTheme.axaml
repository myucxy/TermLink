<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TermLinkBackgroundBrush" Color="#0B0F14" />
      <SolidColorBrush x:Key="TermLinkSurfaceBrush" Color="#121820" />
      <SolidColorBrush x:Key="TermLinkSurfaceVariantBrush" Color="#1B2430" />
      <SolidColorBrush x:Key="TermLinkSurfaceElevatedBrush" Color="#222C39" />
