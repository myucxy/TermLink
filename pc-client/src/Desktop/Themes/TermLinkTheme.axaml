      <SolidColorBrush x:Key="TermLinkPrimaryBrush" Color="#4659A8" />
      <SolidColorBrush x:Key="TermLinkOnPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TermLinkPositiveBrush" Color="#176B45" />
      <SolidColorBrush x:Key="TermLinkOnPositiveBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TermLinkWarningBrush" Color="#715700" />
      <SolidColorBrush x:Key="TermLinkDangerBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="TermLinkOnSurfaceBrush" Color="#171A24" />
      <SolidColorBrush x:Key="TermLinkMutedBrush" Color="#4E5668" />
      <SolidColorBrush x:Key="TermLinkOutlineBrush" Color="#737B8E" />
      <SolidColorBrush x:Key="TermLinkScrimBrush" Color="#660B0F14" />
      <SolidColorBrush x:Key="TermLinkDangerContainerBrush" Color="#F9DEDC" />
      <SolidColorBrush x:Key="TermLinkWarningContainerBrush" Color="#FFF1C2" />
      <SolidColorBrush x:Key="TermLinkPositiveContainerBrush" Color="#D9F5E7" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

