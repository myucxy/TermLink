<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TermLink.TerminalSurface.Validation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" ExcludeAssets="analyzers" GeneratePathProperty="true" />
    <PackageReference Include="Avalonia.Headless" />
    <ProjectReference Include="..\..\src\Desktop\TermLink.Desktop.csproj" />
    <None Include="..\..\..\native\terminal-core\windows-x64\termlink_terminal_ffi.dll"
          Link="termlink_terminal_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveIncompatibleAvaloniaAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup><Analyzer Remove="$(PkgAvalonia)\analyzers\dotnet\cs\*.dll" /></ItemGroup>
  </Target>
</Project>
