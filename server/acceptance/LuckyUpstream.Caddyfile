{
	admin off
	auto_https off
}

:8080 {
	@health path /__termlink_upstream_health
	handle @health {
		respond 200
	}

	@identity path /realms/* /resources/* /robots.txt
	handle @identity {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host termlink.kget.cc:8910
			header_up X-Forwarded-Port 8910
		}
	}

	handle {
		reverse_proxy server:8080
	}
}
