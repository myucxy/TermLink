{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

(termlinkRoutes) {
	@health path /__termlink_upstream_health
	handle @health {
		respond 200
	}

	# Public history URLs share the product origin. Only production-shaped,
	# presigned object requests reach MinIO; MinIO remains responsible for the
	# final SigV4 signature and credential validation.
	@historyObject {
		method GET PUT
		path_regexp history_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/sessions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(chunk|snapshot|transcript)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
		query X-Amz-Algorithm=AWS4-HMAC-SHA256
		query X-Amz-Credential=*
		query X-Amz-Date=*
		query X-Amz-Expires=*
		query X-Amz-SignedHeaders=*
		query X-Amz-Signature=*
	}
	@historyObjectTooLarge {
		method PUT
		path_regexp oversized_history_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/sessions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(chunk|snapshot|transcript)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
		query X-Amz-Algorithm=AWS4-HMAC-SHA256
		query X-Amz-Credential=*
		query X-Amz-Date=*
		query X-Amz-Expires=*
		query X-Amz-SignedHeaders=*
		query X-Amz-Signature=*
		expression `{http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 67108864`
	}
	handle @historyObjectTooLarge {
		# Reject before proxying or consuming a 64 MiB+ body. Forwarding an
		# intentionally oversized probe through the public Lucky hop can turn the
		# bounded 413 contract into a gateway timeout/502 before MinIO responds.
		respond 413
	}
	handle @historyObject {
		request_body {
			max_size 67108864
		}
		header Cache-Control "private, no-store"
		reverse_proxy minio:9000 {
			header_up Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}

	# File transfers are not history chunks. They retain the same exact SigV4
	# gate and UUID-only object shape but have their own 5 GiB ceiling.
	@fileTransferObject {
		method GET PUT
		path_regexp file_transfer_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/file-transfers/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
		query X-Amz-Algorithm=AWS4-HMAC-SHA256
		query X-Amz-Credential=*
		query X-Amz-Date=*
		query X-Amz-Expires=*
		query X-Amz-SignedHeaders=*
		query X-Amz-Signature=*
	}
	@fileTransferObjectTooLarge {
		method PUT
		path_regexp oversized_file_transfer_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/file-transfers/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
		query X-Amz-Algorithm=AWS4-HMAC-SHA256
		query X-Amz-Credential=*
		query X-Amz-Date=*
		query X-Amz-Expires=*
		query X-Amz-SignedHeaders=*
		query X-Amz-Signature=*
		expression `{http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 5368709120`
	}
	handle @fileTransferObjectTooLarge {
		respond 413
	}
	handle @fileTransferObject {
		request_body {
			max_size 5368709120
		}
		header Cache-Control "private, no-store"
		reverse_proxy minio:9000 {
			header_up Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}

	@historyPath path /termlink-history /termlink-history/*
	handle @historyPath {
		respond 404
	}

	@identity path /realms/* /resources/* /robots.txt
	handle @identity {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto {$TERMLINK_ACCEPTANCE_PUBLIC_SCHEME}
			header_up X-Forwarded-Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
			header_up X-Forwarded-Port {$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}

	handle {
		reverse_proxy server:8080 {
			header_up X-Forwarded-Proto {$TERMLINK_ACCEPTANCE_PUBLIC_SCHEME}
			header_up X-Forwarded-Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
			header_up X-Forwarded-Port {$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}
}

# Lucky terminates public TLS outside Docker and forwards to the HTTP listener.
# The internal-CA listener keeps OIDC discovery on the exact public issuer
# while avoiding a second long-running Caddy container.
http://:8080 {
	import termlinkRoutes
}

https://{$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT} {
	tls internal
	import termlinkRoutes
}
