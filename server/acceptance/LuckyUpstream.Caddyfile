{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

(termlinkRoutes) {
	@health path /__termlink_upstream_health
	handle @health {
		respond 200
	}

	@identity path /realms/* /resources/* /robots.txt
	handle @identity {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto {$TERMLINK_ACCEPTANCE_PUBLIC_SCHEME}
			header_up X-Forwarded-Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
			header_up X-Forwarded-Port {$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}

	handle {
		# Compose must start this router before Server because Server uses its
		# private TLS listener for issuer discovery. A read-only subrequest waits
		# for readiness before any mutating request is proxied, leaving the real
		# request body untouched during the Docker DNS/bootstrap interval.
		@serverMutation not method GET HEAD OPTIONS
		forward_auth @serverMutation server:8080 {
			uri /readyz
			lb_try_duration 30s
			lb_try_interval 250ms
		}

		# GET, HEAD, and OPTIONS are safe to retry directly. In particular this
		# keeps WebSocket upgrades connected across the same bootstrap window.
		@serverRead method GET HEAD OPTIONS
		reverse_proxy @serverRead server:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
			header_up X-Forwarded-Proto {$TERMLINK_ACCEPTANCE_PUBLIC_SCHEME}
			header_up X-Forwarded-Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
			header_up X-Forwarded-Port {$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}

		# The mutation preflight above has already proved Server ready. Avoid
		# replaying a non-idempotent request if Server fails after that point.
		reverse_proxy server:8080 {
			header_up X-Forwarded-Proto {$TERMLINK_ACCEPTANCE_PUBLIC_SCHEME}
			header_up X-Forwarded-Host {$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
			header_up X-Forwarded-Port {$TERMLINK_ACCEPTANCE_PUBLIC_PORT}
		}
	}
}

# Lucky terminates public TLS outside Docker and forwards to the HTTP listener.
# The internal-CA listener keeps OIDC discovery on the exact public issuer
# while avoiding a second long-running Caddy container.
http://:8080 {
	import termlinkRoutes
}

https://{$TERMLINK_ACCEPTANCE_PUBLIC_HOST}:{$TERMLINK_ACCEPTANCE_PUBLIC_PORT} {
	tls internal
	import termlinkRoutes
}
