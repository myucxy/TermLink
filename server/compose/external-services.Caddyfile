{
	admin off
	https_port 8443
	auto_https disable_redirects
	acme_ca {$TERMLINK_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	email {$TERMLINK_ACME_EMAIL}
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				url delete
				uri delete
				query delete
			}
		}
	}
}

http://127.0.0.1:8081 {
	reverse_proxy server:8080
}

{$TERMLINK_PUBLIC_HOST:localhost} {
	tls {
		protocols tls1.2 tls1.3
	}

	@internal path /metrics /metrics/* /debug /debug/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy server:8080 {
		health_uri /readyz
		health_interval 30s
		health_timeout 3s
		fail_duration 10s
	}
}
