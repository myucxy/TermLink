{
	admin off
	https_port 8443
	auto_https disable_redirects
	acme_ca {$TERMLINK_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	email {$TERMLINK_ACME_EMAIL}
	# Presigned object URLs are bearer capabilities. Runtime and error logs use
	# a filtered encoder so an upstream failure cannot serialize a full request,
	# URI, or query string even though access logging remains disabled.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				url delete
				uri delete
				query delete
			}
		}
	}
}

# Container-local readiness avoids TLS SNI mismatches while still exercising
# the production server readiness path. This port is never published.
http://127.0.0.1:8081 {
	reverse_proxy server:8080
}

{$TERMLINK_PUBLIC_HOST:localhost} {
	tls {
		protocols tls1.2 tls1.3
	}

	@internal path /metrics /metrics/* /debug /debug/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy server:8080 {
		health_uri /readyz
		health_interval 30s
		health_timeout 3s
		fail_duration 10s
	}
}

{$TERMLINK_HISTORY_PUBLIC_HOST:history.localhost} {
	tls {
		protocols tls1.2 tls1.3
	}

	request_body {
		max_size 67108864
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Presigned history URLs are bearer capabilities. Expose only the exact
	# opaque object shape generated by TermLink, never MinIO bucket, console,
	# health, admin, multipart, delete, or enumeration APIs. Access logging is
	# deliberately not enabled here so SigV4 query credentials are not emitted.
	@history_object {
		method GET PUT
		path_regexp history_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/sessions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(chunk|snapshot)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
	}
	@history_object_too_large {
		method PUT
		path_regexp oversized_history_object_path ^/termlink-history/accounts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/sessions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(chunk|snapshot)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]bin$
		expression `{http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 67108864`
	}
	handle @history_object_too_large {
		respond 413
	}
	handle @history_object {
		header Cache-Control "private, no-store"
		reverse_proxy minio:9000
	}
	handle {
		respond 404
	}
}
