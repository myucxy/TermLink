#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
readonly MARKER_VALUE='termlink-single-node-production-v1'
readonly DEFAULT_DATA_DIR='/opt/termlink'
readonly DEFAULT_BACKUP_DIR='/var/backups/termlink'
# Release packaging replaces this exact marker with the signed immutable Server
# image. The source checkout deliberately has no floating default: developers
# must pass --image, while users of a released single-file installer do not.
readonly BUNDLED_IMAGE='__TERMLINK_BUNDLED_IMAGE__'
readonly SECRET_NAMES=(
  postgres-password
  initial-admin-password
  database-url
  token-signing-key
  account-deletion-identity-key
)

DATA_DIR=''
RUNTIME_DIR=''
SECRETS_DIR=''
CONFIG_FILE=''
PUBLIC_HOST=''
PUBLIC_URL=''
IMAGE=''
HTTP_PORT=''
PUBLIC_PORT=''
BACKUP_RECIPIENT=''
DIRECT_ROUTING_PERMITTED='false'
RESTORE_ACTIVE=0
TEMP_PATHS=()
COMPOSE=()

log() {
  printf '[TermLink] %s\n' "$*"
}

warn() {
  printf '[TermLink] WARNING: %s\n' "$*" >&2
}

die() {
  printf '[TermLink] ERROR: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  local path
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    [[ -n "$path" && -d "$path" ]] && rm -rf -- "$path"
  done
  return 0
}

on_error() {
  local status=$?
  if [[ "$RESTORE_ACTIVE" == 1 && ${#COMPOSE[@]} -gt 0 ]]; then
    set +e
    warn 'restore failed; the application service will remain stopped'
    "${COMPOSE[@]}" stop server >/dev/null 2>&1
  fi
  exit "$status"
}

trap cleanup EXIT
trap on_error ERR

show_help() {
  cat <<'EOF'
TermLink single-node production deployment

Usage:
  termlink-deploy install [--domain HOST] [--image IMAGE] [options]
  termlink-deploy upgrade [--image IMAGE] [--data-dir DIR] [--skip-backup]
  termlink-deploy doctor [--data-dir DIR]
  termlink-deploy backup [--data-dir DIR] [--recipient AGE_RECIPIENT] [--output FILE]
  termlink-deploy restore --input FILE --identity FILE --confirm-restore [--data-dir DIR]
  termlink-deploy credentials [--data-dir DIR]
  termlink-deploy config [options]
  termlink-deploy uninstall --keep-data [--data-dir DIR]
  termlink-deploy render-assets --output DIR

Install/config options:
  --domain HOST              Public DNS name.
  --image IMAGE              docker.io/myucxy/termlink:TAG@sha256:DIGEST.
  --data-dir DIR             Managed deployment directory (default: /opt/termlink).
  --http-port PORT           Loopback origin port (default: 8080).
  --public-port PORT         External HTTPS port (default: 443).
  --backup-recipient VALUE   Native age recipient used by backup and upgrade.
  --enable-direct-routing    Permit negotiated LAN/NAT Direct data routing.
  --disable-direct-routing   Keep Direct probing available but route via Relay.
  --restore FILE             Restore this v4 archive during a fresh install.
  --identity FILE            age identity for --restore.

Missing install values are requested interactively. A released installer embeds
its immutable Server image, so normal installation only asks for the domain.
Source checkouts still require --image explicitly.

TermLink exposes only a loopback HTTP origin. Configure an external HTTPS proxy
to preserve Host and X-Forwarded-Proto and forward WebSocket upgrades to it.
EOF
}

need_root() {
  [[ "${EUID:-$(id -u)}" == 0 ]] || die 'run this command as root (for example with sudo)'
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

validate_port() {
  local value="$1"
  local name="$2"
  [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 && "$value" -le 65535 ]] || \
    die "$name must be an integer from 1 through 65535"
}

validate_domain() {
  local value="${1,,}"
  local label
  [[ ${#value} -le 253 && "$value" == *.* ]] || die 'domain must be a fully qualified DNS name'
  [[ ! "$value" =~ (^|\.)(localhost|invalid|test|example)$ ]] || die 'reserved test domains are not allowed'
  [[ ! "$value" =~ (^|\.)example\.(com|net|org)$ ]] || die 'reserved example domains are not allowed'
  IFS='.' read -r -a labels <<<"$value"
  for label in "${labels[@]}"; do
    [[ "$label" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "invalid DNS label in domain: $label"
  done
}

validate_image() {
  is_valid_image "$1" || \
    die 'image must be docker.io/myucxy/termlink:TAG@sha256:<64 lowercase hex characters>'
}

is_valid_image() {
  [[ "$1" =~ ^docker\.io/myucxy/termlink:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}@sha256:[0-9a-f]{64}$ ]]
}

bundled_image() {
  is_valid_image "$BUNDLED_IMAGE" || return 1
  printf '%s' "$BUNDLED_IMAGE"
}

prompt_required() {
  local variable_name="$1"
  local label="$2"
  local current="${!variable_name}"
  [[ -z "$current" ]] || return
  [[ -t 0 ]] || die "$label is required in non-interactive mode"
  read -r -p "$label: " current
  [[ -n "$current" ]] || die "$label cannot be empty"
  printf -v "$variable_name" '%s' "$current"
}

validate_recipient() {
  [[ "$1" =~ ^age1[023456789acdefghjklmnpqrstuvwxyz]{50,100}$ ]] || \
    die 'backup recipient must be a native age X25519 recipient'
}

canonical_data_dir() {
  local requested="$1"
  local canonical
  local lexical
  [[ "$requested" == /* ]] || die 'data directory must be an absolute path'
  [[ ! "$requested" =~ [[:space:]#=] ]] || die 'data directory cannot contain whitespace, #, or ='
  canonical="$(realpath -m -- "$requested")"
  lexical="$(realpath -ms -- "$requested")"
  [[ "$canonical" == "$lexical" ]] || die 'data directory path cannot contain symbolic links'
  [[ "$canonical" != / ]] || die 'data directory cannot be the filesystem root'
  [[ "$canonical" != /root && "$canonical" != /home ]] || die 'data directory cannot be a home directory root'
  while IFS=: read -r _ _ _ _ _ home _; do
    [[ -z "$home" || "$canonical" != "$(realpath -m -- "$home")" ]] || \
      die 'data directory cannot be a user home directory'
  done < <(getent passwd 2>/dev/null || true)
  printf '%s' "$canonical"
}

set_paths() {
  DATA_DIR="$(canonical_data_dir "${1:-${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}}")"
  RUNTIME_DIR="$DATA_DIR/runtime"
  SECRETS_DIR="$DATA_DIR/secrets"
  CONFIG_FILE="$DATA_DIR/config.env"
}

assert_managed_dir() {
  [[ -d "$DATA_DIR" && ! -L "$DATA_DIR" ]] || die "managed data directory does not exist: $DATA_DIR"
  [[ -f "$DATA_DIR/.termlink-managed" && ! -L "$DATA_DIR/.termlink-managed" ]] || \
    die "managed directory marker is missing: $DATA_DIR"
  [[ "$(<"$DATA_DIR/.termlink-managed")" == "$MARKER_VALUE" ]] || \
    die "managed directory marker is invalid: $DATA_DIR"
}

config_get() {
  local name="$1"
  local line
  line="$(grep -E "^${name}=" "$CONFIG_FILE" | tail -n 1 || true)"
  [[ -n "$line" ]] || die "configuration value is missing: $name"
  printf '%s' "${line#*=}"
}

load_config() {
  assert_managed_dir
  [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || die "configuration file is missing: $CONFIG_FILE"
  [[ -d "$RUNTIME_DIR" && ! -L "$RUNTIME_DIR" ]] || die 'runtime directory is missing or unsafe'
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || die 'secret directory is missing or unsafe'
  [[ "$(stat -c '%a' "$DATA_DIR")" == 700 ]] || die 'managed data directory must have mode 0700'
  [[ "$(stat -c '%a' "$RUNTIME_DIR")" == 700 ]] || die 'runtime directory must have mode 0700'
  [[ "$(stat -c '%a' "$SECRETS_DIR")" == 700 ]] || die 'secret directory must have mode 0700'
  [[ "$(stat -c '%a' "$CONFIG_FILE")" == 600 ]] || die 'configuration file must have mode 0600'
  [[ "$(config_get TERMLINK_CONFIG_VERSION)" == 2 ]] || die 'unsupported deployment configuration version'
  PUBLIC_HOST="$(config_get TERMLINK_PUBLIC_HOST)"
  PUBLIC_URL="$(config_get TERMLINK_PUBLIC_URL)"
  IMAGE="$(config_get TERMLINK_IMAGE)"
  HTTP_PORT="$(config_get TERMLINK_HTTP_PORT)"
  PUBLIC_PORT="$(config_get TERMLINK_PUBLIC_PORT)"
  BACKUP_RECIPIENT="$(grep -E '^TERMLINK_BACKUP_RECIPIENT=' "$CONFIG_FILE" | tail -n 1 | cut -d= -f2- || true)"
  DIRECT_ROUTING_PERMITTED="$(grep -E '^TERMLINK_DIRECT_ROUTING_PERMITTED=' "$CONFIG_FILE" | tail -n 1 | cut -d= -f2- || true)"
  [[ -n "$DIRECT_ROUTING_PERMITTED" ]] || DIRECT_ROUTING_PERMITTED=false
  [[ "$(config_get TERMLINK_RUNTIME_DIR)" == "$RUNTIME_DIR" ]] || die 'runtime directory does not match the managed path'
  [[ "$(config_get TERMLINK_SECRETS_DIR)" == "$SECRETS_DIR" ]] || die 'secret directory does not match the managed path'
  validate_domain "$PUBLIC_HOST"
  validate_image "$IMAGE"
  validate_port "$HTTP_PORT" TERMLINK_HTTP_PORT
  validate_port "$PUBLIC_PORT" TERMLINK_PUBLIC_PORT
  [[ -z "$BACKUP_RECIPIENT" ]] || validate_recipient "$BACKUP_RECIPIENT"
  [[ "$DIRECT_ROUTING_PERMITTED" == true || "$DIRECT_ROUTING_PERMITTED" == false ]] || \
    die 'TERMLINK_DIRECT_ROUTING_PERMITTED must be true or false'
  local expected_public_url="https://$PUBLIC_HOST"
  [[ "$PUBLIC_PORT" == 443 ]] || expected_public_url="$expected_public_url:$PUBLIC_PORT"
  [[ "$PUBLIC_URL" == "$expected_public_url" ]] || die 'public URL does not match the configured host and HTTPS port'
}

write_config() {
  local tmp="$DATA_DIR/.config.env.tmp.$$"
  local public_url="https://$PUBLIC_HOST"
  if [[ "$PUBLIC_PORT" != 443 ]]; then
    public_url="$public_url:$PUBLIC_PORT"
  fi
  PUBLIC_URL="$public_url"
  cat > "$tmp" <<EOF
TERMLINK_CONFIG_VERSION=2
COMPOSE_PROJECT_NAME=termlink
TERMLINK_IMAGE=$IMAGE
TERMLINK_RUNTIME_DIR=$RUNTIME_DIR
TERMLINK_SECRETS_DIR=$SECRETS_DIR
TERMLINK_PUBLIC_HOST=$PUBLIC_HOST
TERMLINK_PUBLIC_URL=$PUBLIC_URL
TERMLINK_HTTP_BIND_IP=127.0.0.1
TERMLINK_HTTP_PORT=$HTTP_PORT
TERMLINK_PUBLIC_PORT=$PUBLIC_PORT
TERMLINK_BACKUP_RECIPIENT=$BACKUP_RECIPIENT
TERMLINK_DIRECT_ROUTING_PERMITTED=$DIRECT_ROUTING_PERMITTED
EOF
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$CONFIG_FILE"
}

write_embedded_runtime_assets() {
  local target_dir="$1"
  local compose_tmp="$target_dir/.compose.yml.tmp.$$"
  if [[ -e "$target_dir" ]]; then
    [[ -d "$target_dir" && ! -L "$target_dir" ]] || die "runtime asset target is unsafe: $target_dir"
  else
    install -d -m 0700 "$target_dir"
  fi
  cat > "$compose_tmp" <<'TERMLINK_COMPOSE_EOF'
name: ${COMPOSE_PROJECT_NAME:-termlink}

x-logging: &default-logging
  driver: json-file
  options:
    max-size: ${TERMLINK_CONTAINER_LOG_MAX_SIZE:-10m}
    max-file: ${TERMLINK_CONTAINER_LOG_MAX_FILES:-5}

services:
  secrets-init:
    image: alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
    user: "0:0"
    entrypoint: ["/bin/sh", "-ec"]
    command:
      - |
        copy_secret() {
          source="$$1"
          destination="$$2"
          owner="$$3"
          test -s "/source/$$source"
          rm -f "$$destination"
          cp "/source/$$source" "$$destination"
          chmod 0400 "$$destination"
          chown "$$owner" "$$destination"
        }
        copy_secret postgres-password /target/postgres/postgres_password 70:70
        copy_secret initial-admin-password /target/server/initial_admin_password 65532:65532
        copy_secret database-url /target/server/database_url 65532:65532
        copy_secret token-signing-key /target/server/token_signing_key 65532:65532
        copy_secret account-deletion-identity-key /target/server/account_deletion_identity_key 65532:65532
    volumes:
      - ${TERMLINK_SECRETS_DIR:?TERMLINK_SECRETS_DIR is required}:/source:ro
      - postgres-secrets:/target/postgres
      - server-secrets:/target/server
    network_mode: none
    read_only: true
    cap_drop: ["ALL"]
    cap_add: ["CHOWN"]
    security_opt: ["no-new-privileges:true"]
    restart: "no"
    logging: *default-logging

  postgres:
    image: postgres:17.5-alpine3.22@sha256:6567bca8d7bc8c82c5922425a0baee57be8402df92bae5eacad5f01ae9544daa
    environment:
      POSTGRES_DB: termlink
      POSTGRES_USER: termlink
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - postgres-secrets:/run/secrets:ro
    networks: ["database"]
    shm_size: ${TERMLINK_POSTGRES_SHM_SIZE:-128m}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U termlink -d termlink"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s
    mem_limit: ${TERMLINK_POSTGRES_MEMORY_LIMIT:-1g}
    mem_reservation: ${TERMLINK_POSTGRES_MEMORY_RESERVATION:-256m}
    cpus: ${TERMLINK_POSTGRES_CPU_LIMIT:-1.50}
    pids_limit: ${TERMLINK_POSTGRES_PIDS_LIMIT:-256}
    restart: unless-stopped
    logging: *default-logging
    depends_on:
      secrets-init:
        condition: service_completed_successfully

  server:
    image: ${TERMLINK_IMAGE:?TERMLINK_IMAGE immutable tag and digest is required}
    environment:
      TERMLINK_RUNTIME_MODE: single-node
      TERMLINK_IDENTITY_PROVIDER: embedded
      TERMLINK_PUBLIC_URL: ${TERMLINK_PUBLIC_URL:?TERMLINK_PUBLIC_URL is required}
      TERMLINK_OIDC_ISSUER: ${TERMLINK_PUBLIC_URL:?TERMLINK_PUBLIC_URL is required}/realms/termlink
      TERMLINK_OIDC_CLIENT_ID: termlink-server
      TERMLINK_OIDC_ALLOWED_PARTIES: termlink-android,termlink-windows
      TERMLINK_ANDROID_OIDC_CLIENT_ID: termlink-android
      TERMLINK_ANDROID_OIDC_REDIRECT_URI: dev.termlink:/oauth2redirect
      TERMLINK_WINDOWS_OIDC_CLIENT_ID: termlink-windows
      TERMLINK_WINDOWS_REGISTRATION_OIDC_PARTIES: termlink-windows
      TERMLINK_WINDOWS_OIDC_REDIRECT_URI: http://127.0.0.1/oauth2/callback
      TERMLINK_WEB_OIDC_CLIENT_ID: termlink-web
      TERMLINK_WEB_STEP_UP_OIDC_CLIENT_ID: termlink-web-step-up
      TERMLINK_WEB_OIDC_REDIRECT_URI: ${TERMLINK_PUBLIC_URL:?TERMLINK_PUBLIC_URL is required}/auth/callback
      TERMLINK_INITIAL_ADMIN_PASSWORD_FILE: /run/secrets/initial_admin_password
      TERMLINK_DATABASE_URL_FILE: /run/secrets/database_url
      TERMLINK_TOKEN_SIGNING_KEY_FILE: /run/secrets/token_signing_key
      TERMLINK_REGISTRATION_RECOVERY_ENABLED: "true"
      TERMLINK_ACCOUNT_DELETION_ENABLED: "true"
      TERMLINK_ACCOUNT_DELETION_IDENTITY_KEY_FILE: /run/secrets/account_deletion_identity_key
      TERMLINK_ACCOUNT_DELETION_IDENTITY_KEY_VERSION: "1"
      TERMLINK_DIRECT_TRANSPORT_ENABLED: "true"
      TERMLINK_DIRECT_ROUTING_PERMITTED: ${TERMLINK_DIRECT_ROUTING_PERMITTED:-false}
      TERMLINK_DIRECT_STUN_SERVERS: ${TERMLINK_DIRECT_STUN_SERVERS:-stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302}
      TERMLINK_APPSHIP_BASE_URL: ${TERMLINK_APPSHIP_BASE_URL:-https://appship.kget.cc:8910}
      TERMLINK_APPSHIP_ALLOWED_PRIVATE_IPS: ${TERMLINK_APPSHIP_ALLOWED_PRIVATE_IPS:-}
      TERMLINK_LISTEN_ADDR: :8080
      TERMLINK_LOG_LEVEL: ${TERMLINK_LOG_LEVEL:-info}
    volumes:
      - server-secrets:/run/secrets:ro
    ports:
      - "${TERMLINK_HTTP_BIND_IP:-127.0.0.1}:${TERMLINK_HTTP_PORT:-8080}:8080"
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=16m
    read_only: true
    user: "65532:65532"
    cap_drop: ["ALL"]
    security_opt: ["no-new-privileges:true"]
    networks: ["database", "egress"]
    healthcheck:
      test: ["CMD", "/termlink-server", "healthcheck"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s
    mem_limit: ${TERMLINK_SERVER_MEMORY_LIMIT:-768m}
    mem_reservation: ${TERMLINK_SERVER_MEMORY_RESERVATION:-192m}
    cpus: ${TERMLINK_SERVER_CPU_LIMIT:-1.50}
    pids_limit: ${TERMLINK_SERVER_PIDS_LIMIT:-256}
    stop_grace_period: 30s
    restart: unless-stopped
    logging: *default-logging
    depends_on:
      postgres:
        condition: service_healthy
      secrets-init:
        condition: service_completed_successfully

volumes:
  postgres-data:
  postgres-secrets:
  server-secrets:

networks:
  database:
    internal: true
  egress:
TERMLINK_COMPOSE_EOF
  chmod 0600 "$compose_tmp"
  mv -f -- "$compose_tmp" "$target_dir/compose.yml"
}

install_runtime_assets() {
  if [[ "$(realpath -m -- "$SCRIPT_PATH")" != "$(realpath -m -- "$DATA_DIR/termlink-deploy")" ]]; then
    install -m 0700 "$SCRIPT_PATH" "$DATA_DIR/termlink-deploy"
  fi
  write_embedded_runtime_assets "$RUNTIME_DIR"
}

random_urlsafe() {
  local bytes="${1:-32}"
  openssl rand -base64 "$bytes" | tr '+/' '-_' | tr -d '=\r\n'
}

write_secret_if_missing() {
  local name="$1"
  local value="$2"
  local path="$SECRETS_DIR/$name"
  if [[ -e "$path" ]]; then
    [[ -f "$path" && ! -L "$path" ]] || die "secret path is unsafe: $path"
    return
  fi
  printf '%s' "$value" > "$path"
  chmod 0600 "$path"
}

initialize_secrets() {
  local postgres_password
  install -d -m 0700 "$SECRETS_DIR"
  write_secret_if_missing postgres-password "$(random_urlsafe 32)"
  write_secret_if_missing initial-admin-password "$(random_urlsafe 24)"
  write_secret_if_missing token-signing-key "$(random_urlsafe 48)"
  write_secret_if_missing account-deletion-identity-key "$(random_urlsafe 32)"
  postgres_password="$(<"$SECRETS_DIR/postgres-password")"
  write_secret_if_missing database-url \
    "postgres://termlink:${postgres_password}@postgres:5432/termlink?sslmode=disable"
  unset postgres_password
  apply_secret_permissions
  verify_secrets
}

apply_secret_permissions() {
  chmod 0600 "$SECRETS_DIR/"*
  chown 70:70 "$SECRETS_DIR/postgres-password"
  chown 65532:65532 \
    "$SECRETS_DIR/initial-admin-password" \
    "$SECRETS_DIR/database-url" \
    "$SECRETS_DIR/token-signing-key" \
    "$SECRETS_DIR/account-deletion-identity-key"
}

verify_secrets() {
  local name
  local value
  local mode
  for name in "${SECRET_NAMES[@]}"; do
    [[ -f "$SECRETS_DIR/$name" && ! -L "$SECRETS_DIR/$name" ]] || die "secret is missing or unsafe: $name"
    mode="$(stat -c '%a' "$SECRETS_DIR/$name")"
    [[ "$mode" == 600 || "$mode" == 400 ]] || die "secret $name must have mode 0600 or 0400"
    value="$(<"$SECRETS_DIR/$name")"
    [[ -n "$value" ]] || die "secret is empty: $name"
  done
  for name in postgres-password initial-admin-password token-signing-key; do
    value="$(<"$SECRETS_DIR/$name")"
    [[ "$value" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || die "secret has invalid encoding: $name"
  done
  value="$(<"$SECRETS_DIR/account-deletion-identity-key")"
  [[ "$value" =~ ^[A-Za-z0-9_-]{43}$ ]] || die 'account deletion key is not an encoded AES-256 key'
  value="$(<"$SECRETS_DIR/postgres-password")"
  [[ "$(<"$SECRETS_DIR/database-url")" == \
    "postgres://termlink:${value}@postgres:5432/termlink?sslmode=disable" ]] || \
    die 'database URL does not match the PostgreSQL password'
  unset value
}

build_compose_commands() {
  local name
  for name in COMPOSE_ENV_FILES COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME \
    TERMLINK_APPSHIP_ALLOWED_PRIVATE_IPS TERMLINK_APPSHIP_BASE_URL \
    TERMLINK_CONTAINER_LOG_MAX_FILES TERMLINK_CONTAINER_LOG_MAX_SIZE \
    TERMLINK_DIRECT_ROUTING_PERMITTED TERMLINK_DIRECT_STUN_SERVERS \
    TERMLINK_HTTP_BIND_IP TERMLINK_HTTP_PORT TERMLINK_IMAGE TERMLINK_LOG_LEVEL \
    TERMLINK_POSTGRES_CPU_LIMIT \
    TERMLINK_POSTGRES_MEMORY_LIMIT TERMLINK_POSTGRES_MEMORY_RESERVATION TERMLINK_POSTGRES_PIDS_LIMIT \
    TERMLINK_POSTGRES_SHM_SIZE TERMLINK_PUBLIC_HOST TERMLINK_PUBLIC_URL TERMLINK_RUNTIME_DIR \
    TERMLINK_SECRETS_DIR TERMLINK_SERVER_CPU_LIMIT TERMLINK_SERVER_MEMORY_LIMIT \
    TERMLINK_SERVER_MEMORY_RESERVATION TERMLINK_SERVER_PIDS_LIMIT; do
    unset "$name"
  done
  COMPOSE=(docker compose --project-directory "$RUNTIME_DIR" --project-name termlink \
    --env-file "$CONFIG_FILE" -f "$RUNTIME_DIR/compose.yml")
}

verify_rendered_compose() {
  local rendered
  local value
  local name
  [[ -f "$RUNTIME_DIR/compose.yml" ]] || die 'runtime Compose file is missing'
  rendered="$("${COMPOSE[@]}" config)"
  [[ -n "$rendered" ]] || die 'Docker Compose rendered an empty configuration'
  for name in "${SECRET_NAMES[@]}"; do
    value="$(<"$SECRETS_DIR/$name")"
    [[ "$rendered" != *"$value"* ]] || die "rendered Compose exposes secret $name"
  done
  unset rendered value
}

require_runtime() {
  need_command docker
  need_command curl
  docker compose version >/dev/null
  load_config
  verify_secrets
  build_compose_commands
  verify_rendered_compose
}

start_stack() {
  log "pulling immutable Server image $IMAGE"
  docker pull "$IMAGE"
  log 'starting PostgreSQL and TermLink Server with embedded identity'
  "${COMPOSE[@]}" up -d --wait --wait-timeout 300 --scale server=1 --remove-orphans
  # secrets-init only copies file-backed secrets with the correct container
  # ownership. Remove its exited container so the steady-state deployment has
  # exactly the two intended services: PostgreSQL and TermLink Server.
  "${COMPOSE[@]}" rm --force secrets-init >/dev/null
}

assert_running_service() {
  local service="$1"
  local running
  running="$("${COMPOSE[@]}" ps --services --filter status=running | grep -Fx "$service" | wc -l)"
  [[ "$running" == 1 ]] || die "service is not running exactly once: $service"
}

doctor_runtime() {
  local response
  local migration
  verify_rendered_compose
  assert_running_service postgres
  assert_running_service server
  [[ "$("${COMPOSE[@]}" ps --services --filter status=running | grep -Fx server | wc -l)" == 1 ]] || \
    die 'single-node deployment must run exactly one Server replica'

  curl --fail --silent --show-error --max-time 10 \
    "http://127.0.0.1:$HTTP_PORT/healthz" >/dev/null
  curl --fail --silent --show-error --max-time 10 \
    "http://127.0.0.1:$HTTP_PORT/readyz" >/dev/null
  response="$(curl --fail --silent --show-error --max-time 10 \
    -H "Host: $PUBLIC_HOST" \
    "http://127.0.0.1:$HTTP_PORT/realms/termlink/.well-known/openid-configuration")"
  [[ "$response" == *"$PUBLIC_URL/realms/termlink"* ]] || \
    die 'OIDC discovery does not advertise the configured public URL'

  migration="$("${COMPOSE[@]}" exec -T postgres psql -U termlink -d termlink \
    -Atqc 'SELECT MAX(version) FROM schema_migrations')"
  [[ "$migration" =~ ^[0-9]+$ ]] || die 'database migration state is unavailable'
  log "deployment is healthy (database migration $migration)"
  log "loopback origin is ready on 127.0.0.1:$HTTP_PORT; external HTTPS must publish $PUBLIC_URL"
}

backup_runtime() {
  local recipient="$1"
  local output="$2"
  local timestamp
  local tmp
  local payload
  local output_dir
  local encrypted_tmp
  need_command age
  need_command sha256sum
  validate_recipient "$recipient"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  [[ -n "$output" ]] || output="$DEFAULT_BACKUP_DIR/termlink-$timestamp.tar.age"
  [[ "$output" == /* ]] || die 'backup output must be an absolute path'
  output="$(realpath -m -- "$output")"
  output_dir="$(dirname "$output")"
  case "$output_dir/" in
    "$DATA_DIR"/*) die 'backup output must be outside the managed data directory' ;;
  esac
  [[ ! -e "$output" && ! -e "$output.tmp" ]] || die "backup output already exists: $output"
  install -d -m 0700 "$output_dir"

  tmp="$(mktemp -d)"
  TEMP_PATHS+=("$tmp")
  payload="$tmp/payload"
  encrypted_tmp="$tmp/backup.tar.age"
  install -d -m 0700 "$payload/database" "$payload/secrets"
  log 'dumping the TermLink database, including embedded identity data'
  "${COMPOSE[@]}" exec -T postgres pg_dump -U termlink -Fc termlink \
    > "$payload/database/termlink.dump"
  chmod 0600 "$payload/database/"*.dump
  local name
  for name in "${SECRET_NAMES[@]}"; do
    install -m 0600 "$SECRETS_DIR/$name" "$payload/secrets/$name"
  done
  cat > "$payload/metadata.env" <<EOF
TERMLINK_BACKUP_VERSION=4
TERMLINK_BACKUP_CREATED_AT=$timestamp
TERMLINK_BACKUP_IMAGE=$IMAGE
TERMLINK_BACKUP_PUBLIC_URL=$PUBLIC_URL
EOF
  chmod 0600 "$payload/metadata.env"
  (
    cd "$payload"
    find database secrets -type f -print0 | sort -z | xargs -0 sha256sum
    sha256sum metadata.env
  ) > "$payload/manifest.sha256"
  chmod 0600 "$payload/manifest.sha256"
  (
    cd "$payload"
    tar -cf - database secrets metadata.env manifest.sha256
  ) | age --encrypt --recipient "$recipient" --output "$encrypted_tmp"
  chmod 0600 "$encrypted_tmp"
  mv -- "$encrypted_tmp" "$output"
  log "encrypted backup created: $output"
}

allowed_archive_member() {
  case "$1" in
    database|database/|database/termlink.dump|secrets|secrets/|metadata.env|manifest.sha256) return 0 ;;
  esac
  local name
  for name in "${SECRET_NAMES[@]}"; do
    [[ "$1" == "secrets/$name" ]] && return 0
  done
  return 1
}

allowed_manifest_path() {
  case "$1" in
    database/termlink.dump|metadata.env) return 0 ;;
  esac
  local name
  for name in "${SECRET_NAMES[@]}"; do
    [[ "$1" == "secrets/$name" ]] && return 0
  done
  return 1
}

validate_restore_payload() {
  local archive="$1"
  local extract_dir="$2"
  local member
  local listing
  local line
  local relative
  local -A seen=()
  mapfile -t members < <(tar -tf "$archive")
  [[ ${#members[@]} -gt 0 ]] || die 'backup archive is empty'
  for member in "${members[@]}"; do
    [[ "$member" != /* && "$member" != *'..'* && "$member" != *'\\'* ]] || \
      die "backup archive contains an unsafe path: $member"
    allowed_archive_member "$member" || die "backup archive contains an unexpected member: $member"
  done
  listing="$(tar -tvf "$archive")"
  if printf '%s\n' "$listing" | awk 'substr($0,1,1) != "-" && substr($0,1,1) != "d" { print; exit }' | grep -q .; then
    die 'backup archive contains a link or unsupported entry type'
  fi
  tar -xf "$archive" -C "$extract_dir" --no-same-owner --no-same-permissions
  [[ "$(grep -E '^TERMLINK_BACKUP_VERSION=' "$extract_dir/metadata.env" | cut -d= -f2-)" == 4 ]] || \
    die 'backup archive version is unsupported'

  while IFS= read -r line; do
    [[ "$line" =~ ^[0-9a-f]{64}\ \ (.+)$ ]] || die 'backup manifest has invalid syntax'
    relative="${BASH_REMATCH[1]}"
    allowed_manifest_path "$relative" || die "backup manifest contains an unexpected path: $relative"
    [[ -z "${seen[$relative]:-}" ]] || die "backup manifest contains a duplicate path: $relative"
    seen["$relative"]=1
  done < "$extract_dir/manifest.sha256"
  for relative in database/termlink.dump metadata.env; do
    [[ "${seen[$relative]:-}" == 1 ]] || die "backup manifest is missing $relative"
  done
  local name
  for name in "${SECRET_NAMES[@]}"; do
    relative="secrets/$name"
    [[ "${seen[$relative]:-}" == 1 ]] || die "backup manifest is missing $relative"
  done
  (cd "$extract_dir" && sha256sum --check --strict manifest.sha256 >/dev/null)
}

restore_runtime() {
  local input="$1"
  local identity="$2"
  local confirmed="$3"
  local tmp
  local archive
  local extract_dir
  local name
  local postgres_password
  [[ "$confirmed" == true ]] || die 'restore requires --confirm-restore'
  need_command age
  need_command sha256sum
  [[ -f "$input" && ! -L "$input" ]] || die "backup archive is missing or unsafe: $input"
  [[ -f "$identity" && ! -L "$identity" ]] || die "age identity is missing or unsafe: $identity"
  tmp="$(mktemp -d)"
  TEMP_PATHS+=("$tmp")
  archive="$tmp/backup.tar"
  extract_dir="$tmp/extracted"
  install -d -m 0700 "$extract_dir"
  age --decrypt --identity "$identity" --output "$archive" "$input"
  validate_restore_payload "$archive" "$extract_dir"

  RESTORE_ACTIVE=1
  log 'stopping the application service for restore'
  "${COMPOSE[@]}" stop server >/dev/null 2>&1 || true
  "${COMPOSE[@]}" up -d --wait --wait-timeout 180 postgres

  log 'restoring TermLink database'
  "${COMPOSE[@]}" exec -T postgres dropdb -U termlink --if-exists --force termlink
  "${COMPOSE[@]}" exec -T postgres createdb -U termlink -O termlink termlink
  "${COMPOSE[@]}" exec -T postgres pg_restore -U termlink -d termlink \
    --exit-on-error --no-acl < "$extract_dir/database/termlink.dump"

  for name in "${SECRET_NAMES[@]}"; do
    install -m 0600 "$extract_dir/secrets/$name" "$SECRETS_DIR/$name"
  done
  apply_secret_permissions
  verify_secrets
  postgres_password="$(<"$SECRETS_DIR/postgres-password")"
  printf "ALTER ROLE termlink LOGIN PASSWORD '%s';\n" "$postgres_password" | \
    "${COMPOSE[@]}" exec -T postgres psql -U termlink -d postgres --set=ON_ERROR_STOP=1 >/dev/null
  unset postgres_password
  printf 'restored\n' > "$DATA_DIR/.initial-credentials-claimed"
  chmod 0600 "$DATA_DIR/.initial-credentials-claimed"

  start_stack
  doctor_runtime
  RESTORE_ACTIVE=0
  log 'restore completed; the current server domain configuration was preserved'
}

create_managed_layout() {
  [[ ! -e "$DATA_DIR" ]] || die "install target already exists; use upgrade: $DATA_DIR"
  install -d -m 0700 "$DATA_DIR" "$RUNTIME_DIR" "$SECRETS_DIR"
  printf '%s' "$MARKER_VALUE" > "$DATA_DIR/.termlink-managed"
  chmod 0600 "$DATA_DIR/.termlink-managed"
  install -m 0700 "$SCRIPT_PATH" "$DATA_DIR/termlink-deploy"
}

claim_initial_credentials() {
  [[ ! -e "$DATA_DIR/.initial-credentials-claimed" ]] || \
    die 'initial administrator credentials have already been displayed'
  (set -o noclobber; printf 'claimed\n' > "$DATA_DIR/.initial-credentials-claimed") 2>/dev/null || \
    die 'initial administrator credentials have already been displayed'
  chmod 0600 "$DATA_DIR/.initial-credentials-claimed"
  printf '\nURL: %s\nUsername: admin\nInitial password: %s\n' \
    "$PUBLIC_URL" "$(<"$SECRETS_DIR/initial-admin-password")"
  printf 'Change this password after signing in; it will not be displayed again.\n\n'
}

command_install() {
  local domain=''
  local image=''
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local http_port=8080
  local public_port=443
  local recipient=''
  local restore_input=''
  local restore_identity=''
  local direct_routing=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --domain) domain="${2:-}"; shift 2 ;;
      --image) image="${2:-}"; shift 2 ;;
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --http-port) http_port="${2:-}"; shift 2 ;;
      --public-port) public_port="${2:-}"; shift 2 ;;
      --backup-recipient) recipient="${2:-}"; shift 2 ;;
      --restore) restore_input="${2:-}"; shift 2 ;;
      --identity) restore_identity="${2:-}"; shift 2 ;;
      --enable-direct-routing) direct_routing=true; shift ;;
      --disable-direct-routing) direct_routing=false; shift ;;
      -h|--help) show_help; return ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  need_root
  for command in realpath openssl install find getent docker curl; do need_command "$command"; done
  if [[ -z "$image" ]] && bundled_image >/dev/null; then
    image="$(bundled_image)"
  fi
  prompt_required domain 'Public domain'
  prompt_required image 'Immutable Server image (tag@sha256:digest)'
  validate_domain "$domain"
  validate_image "$image"
  validate_port "$http_port" --http-port
  validate_port "$public_port" --public-port
  [[ -z "$recipient" ]] || validate_recipient "$recipient"
  [[ -z "$restore_input" && -z "$restore_identity" ]] || \
    [[ -n "$restore_input" && -n "$restore_identity" ]] || \
    die '--restore and --identity must be supplied together'

  set_paths "$data_dir"
  create_managed_layout
  PUBLIC_HOST="${domain,,}"
  IMAGE="$image"
  HTTP_PORT="$http_port"
  PUBLIC_PORT="$public_port"
  BACKUP_RECIPIENT="$recipient"
  DIRECT_ROUTING_PERMITTED="$direct_routing"
  install_runtime_assets
  initialize_secrets
  write_config
  build_compose_commands
  verify_rendered_compose
  if [[ -n "$restore_input" ]]; then
    restore_runtime "$restore_input" "$restore_identity" true
  else
    start_stack
    doctor_runtime
    log "installation completed at $DATA_DIR"
    if [[ -t 1 ]]; then
      claim_initial_credentials
    else
      log "run $DATA_DIR/termlink-deploy credentials once to view the initial administrator password"
    fi
  fi
}

command_upgrade() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local new_image=''
  local skip_backup=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --image) new_image="${2:-}"; shift 2 ;;
      --skip-backup) skip_backup=true; shift ;;
      -h|--help) show_help; return ;;
      *) die "unknown upgrade option: $1" ;;
    esac
  done
  need_root
  set_paths "$data_dir"
  require_runtime
  if [[ -n "$new_image" ]]; then
    validate_image "$new_image"
    IMAGE="$new_image"
  elif bundled_image >/dev/null && [[ "$(bundled_image)" != "$IMAGE" ]]; then
    IMAGE="$(bundled_image)"
    log "selected the immutable Server image bundled with this installer: $IMAGE"
  fi
  install_runtime_assets
  apply_secret_permissions
  write_config
  build_compose_commands
  verify_rendered_compose
  if [[ "$skip_backup" == false ]]; then
    if [[ -n "$BACKUP_RECIPIENT" ]]; then
      backup_runtime "$BACKUP_RECIPIENT" ''
    else
      warn 'no backup recipient is configured; upgrade is proceeding without an automatic backup'
    fi
  fi
  start_stack
  doctor_runtime
  log 'upgrade completed'
}

command_doctor() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      -h|--help) show_help; return ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done
  need_root
  set_paths "$data_dir"
  require_runtime
  doctor_runtime
}

command_backup() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local recipient=''
  local output=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --recipient) recipient="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      -h|--help) show_help; return ;;
      *) die "unknown backup option: $1" ;;
    esac
  done
  need_root
  set_paths "$data_dir"
  require_runtime
  [[ -n "$recipient" ]] || recipient="$BACKUP_RECIPIENT"
  [[ -n "$recipient" ]] || die 'backup requires --recipient or a configured --backup-recipient'
  backup_runtime "$recipient" "$output"
}

command_restore() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local input=''
  local identity=''
  local confirmed=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --input) input="${2:-}"; shift 2 ;;
      --identity) identity="${2:-}"; shift 2 ;;
      --confirm-restore) confirmed=true; shift ;;
      -h|--help) show_help; return ;;
      *) die "unknown restore option: $1" ;;
    esac
  done
  need_root
  [[ -n "$input" && -n "$identity" ]] || die 'restore requires --input and --identity'
  set_paths "$data_dir"
  require_runtime
  restore_runtime "$input" "$identity" "$confirmed"
}

command_credentials() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      -h|--help) show_help; return ;;
      *) die "unknown credentials option: $1" ;;
    esac
  done
  need_root
  set_paths "$data_dir"
  load_config
  verify_secrets
  claim_initial_credentials
}

command_render_assets() {
  local output=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output) output="${2:-}"; shift 2 ;;
      -h|--help) show_help; return ;;
      *) die "unknown render-assets option: $1" ;;
    esac
  done
  [[ -n "$output" ]] || die 'render-assets requires --output DIR'
  for command in realpath install; do need_command "$command"; done
  output="$(realpath -m -- "$output")"
  [[ "$output" != / ]] || die 'render-assets output cannot be the filesystem root'
  [[ ! -L "$output" ]] || die 'render-assets output cannot be a symbolic link'
  write_embedded_runtime_assets "$output"
  log "runtime assets rendered to $output"
}

command_config() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local new_domain=''
  local new_image=''
  local new_http=''
  local new_public_port=''
  local new_recipient='__unchanged__'
  local new_direct_routing='__unchanged__'
  local show_only=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --domain) new_domain="${2:-}"; show_only=false; shift 2 ;;
      --image) new_image="${2:-}"; show_only=false; shift 2 ;;
      --http-port) new_http="${2:-}"; show_only=false; shift 2 ;;
      --public-port) new_public_port="${2:-}"; show_only=false; shift 2 ;;
      --backup-recipient) new_recipient="${2:-}"; show_only=false; shift 2 ;;
      --clear-backup-recipient) new_recipient=''; show_only=false; shift ;;
      --enable-direct-routing) new_direct_routing=true; show_only=false; shift ;;
      --disable-direct-routing) new_direct_routing=false; show_only=false; shift ;;
      -h|--help) show_help; return ;;
      *) die "unknown config option: $1" ;;
    esac
  done
  need_root
  set_paths "$data_dir"
  require_runtime
  if [[ "$show_only" == true ]]; then
    sed -E '/^(TERMLINK_RUNTIME_DIR|TERMLINK_SECRETS_DIR)=/d' "$CONFIG_FILE"
    return
  fi
  [[ -z "$new_domain" ]] || { validate_domain "$new_domain"; PUBLIC_HOST="${new_domain,,}"; }
  [[ -z "$new_image" ]] || { validate_image "$new_image"; IMAGE="$new_image"; }
  [[ -z "$new_http" ]] || { validate_port "$new_http" --http-port; HTTP_PORT="$new_http"; }
  [[ -z "$new_public_port" ]] || { validate_port "$new_public_port" --public-port; PUBLIC_PORT="$new_public_port"; }
  if [[ "$new_recipient" != __unchanged__ ]]; then
    [[ -z "$new_recipient" ]] || validate_recipient "$new_recipient"
    BACKUP_RECIPIENT="$new_recipient"
  fi
  if [[ "$new_direct_routing" != __unchanged__ ]]; then
    DIRECT_ROUTING_PERMITTED="$new_direct_routing"
  fi
  write_config
  build_compose_commands
  verify_rendered_compose
  start_stack
  doctor_runtime
  log 'configuration updated and applied'
}

command_uninstall() {
  local data_dir="${TERMLINK_DATA_DIR:-$DEFAULT_DATA_DIR}"
  local keep_data=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) data_dir="${2:-}"; shift 2 ;;
      --keep-data) keep_data=true; shift ;;
      -h|--help) show_help; return ;;
      *) die "unknown uninstall option: $1" ;;
    esac
  done
  need_root
  [[ "$keep_data" == true ]] || die 'only non-destructive uninstall --keep-data is supported'
  set_paths "$data_dir"
  require_runtime
  "${COMPOSE[@]}" down --remove-orphans
  log "containers and networks removed; Docker volumes and $DATA_DIR were preserved"
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "$command" in
    install) command_install "$@" ;;
    upgrade) command_upgrade "$@" ;;
    doctor) command_doctor "$@" ;;
    backup) command_backup "$@" ;;
    restore) command_restore "$@" ;;
    credentials) command_credentials "$@" ;;
    config) command_config "$@" ;;
    uninstall) command_uninstall "$@" ;;
    render-assets) command_render_assets "$@" ;;
    help|-h|--help) show_help ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
