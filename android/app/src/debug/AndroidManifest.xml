<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:usesCleartextTraffic="${termlinkUsesCleartextTraffic}">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name="dev.termlink.product.debug.TailFirstE2EReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.termlink.product.debug.TAIL_FIRST_E2E" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="dev.termlink.product.debug.DirectProductE2EReceiver"
            android:enabled="${termlinkDirectProductE2EEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.termlink.product.debug.DIRECT_PRODUCT_E2E" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
