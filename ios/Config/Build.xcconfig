IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = TermLink/Resources/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = dev.termlink.ios
PRODUCT_NAME = TermLink
MARKETING_VERSION = 0.3.16
CURRENT_PROJECT_VERSION = 146
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_OBJC_BRIDGING_HEADER = TermLink/TermLink-Bridging-Header.h
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_PREVIEWS = YES
CODE_SIGN_STYLE = Automatic
// Supply a team locally without committing signing identities or provisioning profiles.
#include? "../Local.xcconfig"
